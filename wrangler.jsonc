{
  "name": "dbless",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-23",
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "dbless" }
  ],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "MAX_DOCUMENT_BYTES": "262144"
  }
}
