# Central dbless Vercel project and admin CLI only. Consuming apps need none of these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dbless
CURSOR_SECRET=
MAX_DOCUMENT_BYTES=262144

# Local test app only (do not configure DBLESS_API_KEY on the central service)
DBLESS_URL=http://127.0.0.1:8787
DBLESS_API_KEY=
