{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["api/**/*.ts", "service/**/*.ts", "sdk/**/*.ts", "cli/**/*.ts", "local/**/*.ts", "tests/**/*.ts"]
}
